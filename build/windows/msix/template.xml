<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="gomail"
        Arguments=""
        InstallLocation="C:\Program Files\gomail\gomail">
    </Installer>
    <PackageInformation
        PackageName="gomail"
        PackageDisplayName="gomail"
        PublisherName="CN=gomail"
        PublisherDisplayName="gomail"
        Version="0.1.0.0"
        PackageDescription="A gomail application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.avmg20.gomail"
                Description="A gomail application"
                DisplayName="gomail"
                ExecutableName="gomail"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>gomail</DisplayName>
            <PublisherDisplayName>gomail</PublisherDisplayName>
            <Description>A gomail application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="gomail.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
